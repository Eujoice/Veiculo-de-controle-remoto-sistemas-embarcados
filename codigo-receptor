// Código receptor
#include <VirtualWire.h>
#include <ServoTimer2.h>

const int PIN_RX    = 8;
const int PIN_FAROL = 3;
const int PIN_SERVO = 4;

const int PIN_EN  = 5;  
const int PIN_IN1 = 7;  
const int PIN_IN2 = 6;  

ServoTimer2 servo;

// converte graus p microssegundo (ServoTimer2 usa µs)
int grausParaUs(int graus) {
  return map(graus, 0, 180, 600, 2400);
}

void setup() {
  pinMode(PIN_FAROL, OUTPUT);
  pinMode(PIN_EN,    OUTPUT);
  pinMode(PIN_IN1,   OUTPUT);
  pinMode(PIN_IN2,   OUTPUT);

  digitalWrite(PIN_FAROL, LOW);
  digitalWrite(PIN_IN1,   LOW);
  digitalWrite(PIN_IN2,   LOW);
  analogWrite(PIN_EN, 0);

  servo.attach(PIN_SERVO);
  servo.write(1500); // centro = 90 graus em microssegundos

  vw_set_rx_pin(PIN_RX);
  vw_set_ptt_inverted(true);
  vw_setup(2000);
  vw_rx_start();
}

void loop() {
  uint8_t pacote[VW_MAX_MESSAGE_LEN];
  uint8_t tamanho = VW_MAX_MESSAGE_LEN;

  if (vw_get_message(pacote, &tamanho) && tamanho == 4) {

    uint8_t velocidade = pacote[0];
    uint8_t dir_motor  = pacote[1];
    uint8_t angulo_srv = pacote[2];
    uint8_t farol      = pacote[3];

    // farol
    digitalWrite(PIN_FAROL, farol ? HIGH : LOW);

    // servo
    servo.write(grausParaUs(angulo_srv));

    // motor CC
    switch (dir_motor) {
      case 1: // frente
        digitalWrite(PIN_IN1, HIGH);
        digitalWrite(PIN_IN2, LOW);
        analogWrite(PIN_EN, velocidade);
        break;
      case 2: // ré
        digitalWrite(PIN_IN1, LOW);
        digitalWrite(PIN_IN2, HIGH);
        analogWrite(PIN_EN, velocidade);
        break;
      default: // parado
        digitalWrite(PIN_IN1, LOW);
        digitalWrite(PIN_IN2, LOW);
        analogWrite(PIN_EN, 0);
        break;
    }
  }
}
